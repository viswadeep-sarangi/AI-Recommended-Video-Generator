{
  "supabase": {
    "url": "env:SUPABASE_URL",
    "service_key": "env:SUPABASE_SERVICE_KEY",
    "schema": "avgen",
    "tables": {
      "topics": "topics", "youtube_videos": "youtube_videos", "scripts": "scripts", "scene_files": "scene_files",
      "video_scenes": "video_scenes", "audio_files": "audio_files", "final_videos": "final_videos"
    },
    "buckets": {
      "scripts": "scripts", "scenes": "scenes", "videos": "video-scenes", "audio": "audio", "final": "final-videos"
    }
  },
  "scout": {
    "llm": {"provider": "openai", "api_key": "env:OPENAI_API_KEY", "model": "gpt-4o-mini"},
    "lookback_days": 60,
    "top_n": 10,
    "notify_top_x": 5,
    "seed_topics": ["technology", "science facts"],
    "prepend_instructions": "You are a trend analyst for short-form video.",
    "append_instructions": "Avoid controversial or unsafe topics.",
    "sources": [
      {"type": "youtube", "enabled": true, "api_key": "env:YOUTUBE_API_KEY",
       "queries": ["scary stories #shorts", "unsolved mysteries #shorts", "dark history #shorts",
                   "psychology facts #shorts", "what if #shorts", "deep sea creatures #shorts",
                   "ancient civilizations #shorts", "animal facts #shorts", "money facts #shorts",
                   "abandoned places #shorts"],
       "order": "viewCount", "max_results": 15, "regionCode": "US", "videoDuration": "short",
       "relevanceLanguage": "en", "audio_languages": ["en"]}
    ]
  },
  "notifications": {"enabled": false, "type": "telegram", "bot_token": "env:TELEGRAM_BOT_TOKEN", "chat_id": "env:TELEGRAM_CHAT_ID"},
  "script": {
    "llm": {"provider": "openai", "api_key": "env:OPENAI_API_KEY", "model": "gpt-4o-mini"},
    "context": "Tone: energetic, curious. Hook in the first sentence.",
    "append_instructions": "",
    "target_seconds": 30,
    "words_per_second": 2.5,
    "max_per_run": 3
  },
  "scenes": {
    "llm": {"provider": "openai", "api_key": "env:OPENAI_API_KEY", "model": "gpt-4o-mini"},
    "min_scene_seconds": 2,
    "max_scene_seconds": 5,
    "max_per_run": 20,
    "llm_attempts": 2,
    "words_per_second": 2.5,
    "prepend_instructions": "",
    "append_instructions": "Visual prompts must be self-contained and cinematic."
  },
  "video": {
    "max_scene_files_per_run": 5,
    "max_attempts_per_scene": 3,
    "max_usd_per_month": 30,
    "provider": {
      "type": "seedance",
      "api_key": "env:ARK_API_KEY",
      "base_url": "https://ark.ap-southeast.bytepluses.com/api/v3",
      "resolution": "480p",
      "ratio": "9:16",
      "min_seconds": 2,
      "max_seconds": 12,
      "camera_fixed": false
    },
    "models": [
      {"model": "seedance-1-0-pro-250528", "usd_per_million_tokens": 2.5, "free_quota_only": true},
      {"model": "seedance-1-0-pro-fast-251015", "usd_per_million_tokens": 1.0, "free_quota_only": false}
    ]
  },
  "audio": {
    "max_scripts_per_run": 10,
    "max_attempts_per_script": 3,
    "wait_for_clips": true,
    "voice": {
      "provider": "openai_tts",
      "api_key": "env:OPENAI_API_KEY",
      "model": "gpt-4o-mini-tts",
      "voice": "alloy",
      "instructions": "Energetic, curious storyteller. Clear and well paced.",
      "usd_per_minute": 0.015
    },
    "music": {"provider": "none"},
    "captions": {
      "enabled": true,
      "provider": "openai",
      "api_key": "env:OPENAI_API_KEY",
      "model": "whisper-1",
      "language": "en",
      "usd_per_minute": 0.006,
      "srt_min_words": 3,
      "srt_max_words": 8
    }
  },
  "assemble": {
    "max_scripts_per_run": 5,
    "max_attempts_per_script": 3,
    "music_volume": 0.15,
    "output": {
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "fit": "crop",
      "crf": 20,
      "preset": "medium",
      "audio_bitrate": "192k",
      "audio_sample_rate": 48000
    },
    "subtitles": {
      "enabled": true,
      "min_words": 2,
      "max_words": 4,
      "max_pause_seconds": 0.6,
      "style": {
        "font": "DejaVu Sans",
        "font_size": 58,
        "bold": true,
        "italic": false,
        "uppercase": false,
        "color": "#FFFFFF",
        "outline_color": "#000000",
        "outline_width": 4,
        "shadow_color": "#00000080",
        "shadow_depth": 2,
        "box": false,
        "box_color": "#000000B0",
        "position": "bottom",
        "margin_vertical": 150,
        "margin_horizontal": 80,
        "letter_spacing": 0
      }
    }
  }
}
